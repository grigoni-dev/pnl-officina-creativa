# Copia in .env per lo sviluppo locale; su Vercel vanno in Settings > Environment Variables.
# Vedi SETUP.md per dove trovare ogni valore.

# Indirizzo pubblico del sito (serve per i link nelle email e i ritorni da Stripe)
SITE_URL=http://localhost:4321

# Supabase > Project Settings > API
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe > Developers > API keys (sk_test_... per le prove)
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > endpoint .../api/stripe-webhook > Signing secret
STRIPE_WEBHOOK_SECRET=

# Resend > API Keys
RESEND_API_KEY=
# Finché il dominio non è verificato su Resend, onboarding@resend.dev consegna solo
# all'email del proprietario dell'account Resend.
EMAIL_FROM=PNL Officina Creativa <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Una stringa casuale qualsiasi: serve a non salvare gli IP in chiaro nel limite di richieste
RATE_LIMIT_SALT=
