---
import { contatti } from '../data/site';

const links = [
  { href: '/#chi-siamo', label: 'Chi siamo' },
  { href: '/eventi', label: 'Eventi' },
  { href: '/album', label: 'Album' },
  { href: '/#tessera', label: 'Tessera' },
  { href: '/#contatti', label: 'Contatti' },
];
// Simple glyphs in the ink colour, not the brands' own colours.
const social = [
  { nome: 'Instagram', url: contatti.instagram, path: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2.2A2.8 2.8 0 0 0 4.2 7v10A2.8 2.8 0 0 0 7 19.8h10a2.8 2.8 0 0 0 2.8-2.8V7A2.8 2.8 0 0 0 17 4.2H7Zm5 3.3a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 2.2a2.3 2.3 0 1 0 0 4.6 2.3 2.3 0 0 0 0-4.6Zm5.2-3.6a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Z' },
  { nome: 'Facebook', url: contatti.facebook, path: 'M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.5c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V22h3.4Z' },
].filter((x) => x.url);
---
<header class="mast">
  <div class="wrap mast__row">
    <a class="mark reg-host" href="/" aria-label="PNL Officina Creativa, home">
      <span class="mark__pnl reg" aria-hidden="true">
        <span class="reg__blue">PNL</span><span class="reg__pink">PNL</span>
      </span>
      <span class="mark__sub" aria-hidden="true">Officina<br />Creativa</span>
    </a>

    <nav class="mast__nav" aria-label="Principale">
      <ul>
        {links.map((l) => <li><a class="mast__link" href={l.href} aria-current={Astro.url.pathname.startsWith(l.href) && l.href !== '/' && !l.href.includes('#') ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>

    {social.length > 0 && (
      <ul class="mast__social">
        {social.map((x) => (
          <li><a href={x.url!} target="_blank" rel="noopener me" aria-label={`${x.nome} (si apre in una nuova scheda)`}>
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d={x.path} fill="currentColor" /></svg>
          </a></li>
        ))}
      </ul>
    )}

    <button class="mast__menu" type="button" aria-expanded="false" aria-controls="menu">
      <span class="sr-only">Apri il menu</span>
      <svg width="28" height="20" viewBox="0 0 28 20" aria-hidden="true"><path d="M0 3h28M0 10h28M0 17h28" stroke="currentColor" stroke-width="3"/></svg>
    </button>
  </div>

  <div class="menu" id="menu" hidden>
    <ul class="wrap">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href="/verifica">Verifica tessera</a></li>
    </ul>
    {social.length > 0 && (
      <ul class="wrap menu__social">
        {social.map((x) => <li><a class="link" href={x.url!} target="_blank" rel="noopener me">{x.nome} ↗</a></li>)}
      </ul>
    )}
  </div>
</header>


<script>
  const btn = document.querySelector<HTMLButtonElement>('.mast__menu');
  const menu = document.getElementById('menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('.sr-only')!.textContent = open ? 'Chiudi il menu' : 'Apri il menu';
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
  }
</script>

<style>
  .mast {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: var(--rule) solid var(--blue);
  }
  .mast__row {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
    min-height: var(--mast-row);
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
  }
  .mark__pnl {
    font-stretch: 125%;
    font-weight: 900;
    font-size: 2.1rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .mark__sub {
    font-size: var(--step--2);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .mast__nav ul { display: flex; gap: clamp(16px, 2.4vw, 36px); }
  .mast__link {
    font-weight: 700;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 3px no-repeat;
    padding-block: 6px;
    transition: background-size 320ms var(--ease-out);
  }
  .mast__link:hover, .mast__link[aria-current] { background-size: 100% 3px; }
  .mast__social { display: flex; gap: 4px; margin-right: -10px; }
  .mast__social a {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--blue);
    transition: color 160ms;
  }
  .mast__social a:hover, .mast__social a:focus-visible { color: var(--pink); }

  .mast__menu {
    display: none;
    width: 52px;
    height: 52px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--blue);
    cursor: pointer;
  }

  .menu {
    position: fixed;
    inset: var(--mast-h) 0 0;
    background: var(--paper);
    padding-block: 24px 40px;
    display: grid;
    align-content: space-between;
    overflow-y: auto;
  }
  .menu[hidden] { display: none; }
  .menu ul { display: grid; }
  .menu li a {
    display: block;
    padding-block: 14px;
    border-bottom: var(--rule) solid var(--blue);
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(1.6rem, 7vw, 2.6rem);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .menu .menu__social { display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .menu .menu__social a { display: inline; padding-block: 0 2px; border-bottom: 0; font-stretch: 100%; font-weight: 700; font-size: var(--step-1); letter-spacing: 0; }

  @media (max-width: 1080px) {
    .mast__nav { display: none; }
    .mast__menu { display: inline-flex; }
    .mast__social { margin-right: 0; }
  }
  @media (max-width: 760px) {
    .mark__sub { display: none; }
    .mast__row { gap: 8px; }
  }
</style>
