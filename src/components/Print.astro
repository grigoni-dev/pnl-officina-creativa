---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Foto } from '../data/site';

/**
 * A photograph, shown clean: no halftone, no overlay. Local images go through
 * astro:assets (responsive webp); remote ones (Supabase) are plain <img>.
 * `stamp` marks stand-in photos until the real ones arrive.
 */
interface Props {
  foto: Foto;
  widths: number[];
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  stamp?: string;
}
const { foto, widths, sizes, class: cls = '', loading = 'lazy', stamp } = Astro.props;
const style = foto.posizione ? `object-position:${foto.posizione}` : undefined;
const remota = typeof foto.src === 'string';
---
<figure class:list={['print', cls]}>
  {remota
    ? <img src={foto.src as string} width={foto.width} height={foto.height} alt={foto.alt} style={style} loading={loading} decoding="async" />
    : <Image src={foto.src as ImageMetadata} widths={widths} sizes={sizes} alt={foto.alt} style={style} loading={loading} format="webp" quality={78} fetchpriority={loading === 'eager' ? 'high' : undefined} />}
  {stamp && <span class="stamp">{stamp}</span>}
</figure>
