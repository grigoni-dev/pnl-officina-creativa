---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Reg from '../../components/Reg.astro';
import { contatti } from '../../data/site';
import { giornoEvento, orario } from '../../lib/eventi';
import { leggiOrdineCompleto, type OrdineCompleto } from '../../lib/ordini';
import { completaPagamento } from '../../lib/pagamenti';
import { qrSvg } from '../../lib/qr';
import { indirizzoSito } from '../../lib/sito';
import { idCheckoutValido, leggiCheckout } from '../../lib/sumup';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

// From the payment page (?checkout) or from a free booking (?ordine). The webhook
// usually confirmed the order already; if not, this does it, after reading the
// checkout back from SumUp (idempotent).
const sito = indirizzoSito(Astro.url);
const sid = Astro.url.searchParams.get('checkout') ?? '';
const oid = Astro.url.searchParams.get('ordine') ?? '';
let ordine: OrdineCompleto | null = null;
let stato: 'ok' | 'attesa' | 'errore' = 'errore';
try {
  let id: string | null = null;
  if (idCheckoutValido(sid)) {
    const c = await leggiCheckout(sid);
    if (c.status === 'FAILED' || c.status === 'EXPIRED') return Astro.redirect(`/pagamento/${c.id}`, 303);
    id = (await completaPagamento(c, sito, true))?.ordineId ?? null;
    if (!id) stato = 'attesa';
  } else if (/^[0-9a-f-]{36}$/.test(oid)) id = oid;
  if (id) {
    ordine = await leggiOrdineCompleto(id);
    stato = ordine?.stato === 'confermato' ? 'ok' : ordine ? 'attesa' : 'errore';
  }
} catch (err) {
  console.error('grazie biglietti', err);
}
const validi = ordine?.biglietti.filter((b) => b.stato === 'valido') ?? [];
const qr = await Promise.all(validi.map((b) => qrSvg(`${sito}/biglietto/${b.codice}`)));
const ev = ordine?.evento;
---
<Base title="I tuoi biglietti · PNL Officina Creativa" description="I tuoi biglietti." noindex>
  <Nav />
  <main id="contenuto" class="ok">
    <div class="wrap ok__in">
      {stato === 'ok' && ordine && ev && (
        <>
          <Reg as="h1" class="display h2" text={validi.length === 1 ? 'Ecco il tuo biglietto.' : `Ecco i tuoi ${validi.length} biglietti.`} />
          <p class="lede">{ev.titolo} · {giornoEvento(new Date(ev.inizio))}, {orario({ inizio: new Date(ev.inizio), fine: new Date(ev.fine) })} · {ev.luogo_nome}</p>
          <p class="body">Te li abbiamo mandati anche a <strong>{ordine.email}</strong>. All’ingresso mostra il QR, dal telefono o stampato: uno per persona.</p>
          <ul class="ok__biglietti">
            {validi.map((b, i) => (
              <li class="ok__b">
                <div class="ok__qr" set:html={qr[i]} />
                <p class="ok__nome">{b.nome} {b.cognome}</p>
                <a class="link" href={`/biglietto/${b.codice}`}>Apri a schermo intero</a>
              </li>
            ))}
          </ul>
        </>
      )}
      {stato === 'attesa' && (
        <>
          <Reg as="h1" class="display h2" text="Pagamento in arrivo." />
          <p class="lede">SumUp sta ancora confermando il pagamento. Appena arriva ti mandiamo i biglietti per email: non serve rifare nulla.</p>
        </>
      )}
      {stato === 'errore' && (
        <>
          <Reg as="h1" class="display h2" text="Non troviamo questo ordine." />
          <p class="lede">Se hai pagato, i biglietti ti arrivano comunque per email entro pochi minuti. Altrimenti scrivici a <a class="link" href={`mailto:${contatti.email}`}>{contatti.email}</a>.</p>
        </>
      )}
      <a class="btn btn--paper" href="/eventi">Torna agli eventi</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .ok { min-height: 70svh; padding-block: clamp(48px, 7vw, 104px); }
  .ok__in { display: grid; gap: 28px; justify-items: start; }
  .ok__biglietti { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; width: 100%; }
  .ok__b { display: grid; gap: 10px; justify-items: start; border: var(--rule) solid var(--blue); background: #fff; padding: 16px; }
  .ok__qr { width: 100%; max-width: 240px; }
  .ok__qr :global(svg) { width: 100%; height: auto; display: block; }
  .ok__nome { font-stretch: 112%; font-weight: 800; font-size: var(--step-1); }
</style>
