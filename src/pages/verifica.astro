---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reg from '../components/Reg.astro';
import { contatti } from '../data/site';
import { entroIlLimite, impronta } from '../lib/limiti';
import { contattoValido, socioDaContatto } from '../lib/contatti';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

// Looks up a member by the email or phone used to join and answers with the
// status only: never a name, never anything else. Rate limited per connection.
const contatto = (Astro.url.searchParams.get('contatto') ?? '').trim().slice(0, 120);
type Esito = null | 'attiva' | 'nessuna' | 'non-valido' | 'limite' | 'errore';
let esito = null as Esito;

if (contatto) {
  if (!contattoValido(contatto)) esito = 'non-valido';
  else {
    try {
      const chi = await impronta(Astro.request, Astro.clientAddress);
      if (!(await entroIlLimite(`verifica:${chi}`, 20, 600))) {
        esito = 'limite';
        Astro.response.status = 429;
      } else {
        esito = (await socioDaContatto(contatto)) ? 'attiva' : 'nessuna';
      }
    } catch (err) {
      console.error('verifica', err);
      esito = 'errore';
    }
  }
}
---
<Base title="Verifica la tessera · PNL Officina Creativa" description="Controlla se una tessera di PNL Officina Creativa è attiva.">
  <Nav />
  <main id="contenuto" class="ver">
    <div class="wrap ver__in">
      <Reg as="h1" class="display h1" text="Verifica la tessera" />

      <form class="ver__form" method="get">
        <div class="field">
          <label for="contatto">Email o telefono</label>
          <input id="contatto" name="contatto" type="text" autocomplete="email" value={contatto} required maxlength="120" />
        </div>
        <button class="btn" type="submit">Verifica</button>
      </form>

      <div class="ver__esito" role="status" aria-live="polite">
        {esito === 'attiva' && <p class="esito esito--ok"><span class="label">Tessera</span><strong class="display">Attiva</strong></p>}
        {esito === 'nessuna' && <p class="esito"><span class="label">Tessera</span><strong class="display">Non trovata</strong></p>}
        {esito === 'non-valido' && <p class="lede">Scrivi un’email o un numero di telefono validi.</p>}
        {esito === 'limite' && <p class="lede">Troppe verifiche in poco tempo. Riprova tra qualche minuto.</p>}
        {esito === 'errore' && <p class="lede">La verifica non è disponibile in questo momento. Scrivici a <a class="link" href={`mailto:${contatti.email}`}>{contatti.email}</a>.</p>}
      </div>

      <p class="body ver__note">Usa l’email o il telefono con cui ti sei iscritto. Mostriamo solo se la tessera è attiva, mai altri dati. Se non la trovi, scrivici.</p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .ver { min-height: 70svh; padding-block: clamp(48px, 8vw, 120px); }
  .ver__in { display: grid; gap: 36px; justify-items: start; }
  .ver__form { display: flex; flex-wrap: wrap; align-items: end; gap: 16px 20px; width: min(100%, 560px); }
  .ver__form .field { flex: 1 1 240px; }
  .esito { display: grid; gap: 6px; border-top: var(--rule) solid var(--blue); padding-top: 14px; min-width: min(100%, 420px); }
  .esito strong { font-size: var(--step-3); }
  .esito--ok strong { background: var(--pink); color: var(--overprint); padding: 0.06em 0.14em 0; justify-self: start; }
  .ver__note { font-size: var(--step--1); font-weight: 600; max-width: 52ch; }
  @media (max-width: 560px) { .ver__form .btn { width: 100%; } }
</style>
