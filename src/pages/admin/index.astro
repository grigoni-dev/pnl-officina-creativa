---
import Base from '../../layouts/Base.astro';
---
<Base title="Admin · PNL Officina Creativa" description="Area riservata." noindex>
  <header class="adm-top">
    <div class="wrap adm-top__row">
      <a class="adm-mark" href="/">PNL <span class="label">Admin</span></a>
      <nav class="adm-tabs" aria-label="Sezioni" hidden>
        <a href="#eventi" data-tab="eventi">Eventi</a>
        <a href="#album" data-tab="album">Album</a>
        <a href="#soci" data-tab="soci">Soci</a>
        <a href="#comunicazioni" data-tab="comunicazioni">Comunicazioni</a>
        <a href="/admin/ingresso">Ingresso ↗</a>
      </nav>
      <button class="adm-esci link" type="button" hidden>Esci</button>
    </div>
  </header>

  <main id="contenuto" class="wrap adm">
    <p class="adm-msg" role="status" aria-live="polite"></p>

    <!-- login -->
    <section class="adm-view" data-view="login" hidden>
      <h1 class="display h2">Area riservata</h1>
      <form class="adm-login">
        <div class="field"><label for="l-email">Email</label><input id="l-email" name="email" type="email" autocomplete="username" required /></div>
        <div class="field"><label for="l-pw">Password</label><input id="l-pw" name="password" type="password" autocomplete="current-password" required /></div>
        <button class="btn" type="submit">Entra</button>
      </form>
    </section>

    <section class="adm-view" data-view="config" hidden>
      <h1 class="display h2">Supabase non collegato</h1>
      <p class="body">Mancano PUBLIC_SUPABASE_URL e PUBLIC_SUPABASE_ANON_KEY. Vedi SETUP.md.</p>
    </section>

    <!-- ================= EVENTI ================= -->
    <section class="adm-view" data-view="eventi" hidden>
      <div class="adm-head">
        <h1 class="display h2">Eventi</h1>
        <a class="btn" href="#eventi/nuovo">Nuovo evento</a>
      </div>
      <ul class="adm-lista adm-eventi"></ul>
    </section>

    <section class="adm-view" data-view="evento" hidden>
      <a class="link" href="#eventi">← Tutti gli eventi</a>
      <form class="adm-card adm-evento">
        <h2 class="display h3 adm-evento__titolo">Nuovo evento</h2>
        <div class="adm-fields">
          <div class="field field--wide"><label for="e-titolo">Titolo</label><input id="e-titolo" name="titolo" required maxlength="120" /></div>
          <div class="field"><label for="e-data">Data</label><input id="e-data" name="data" type="date" required /></div>
          <div class="field"><label for="e-inizio">Ora di inizio</label><input id="e-inizio" name="ora_inizio" type="time" required /></div>
          <div class="field"><label for="e-fine">Ora di fine</label><input id="e-fine" name="ora_fine" type="time" required /><p class="field__hint">Se è prima dell’inizio, vale il giorno dopo</p></div>
          <div class="field"><label for="e-luogo">Luogo</label><input id="e-luogo" name="luogo_nome" required maxlength="120" /></div>
          <div class="field field--wide"><label for="e-ind">Indirizzo (per la mappa)</label><input id="e-ind" name="luogo_indirizzo" maxlength="200" /></div>
          <div class="field field--wide"><label for="e-descr">Descrizione</label><textarea id="e-descr" name="descrizione" rows="7" maxlength="5000"></textarea><p class="field__hint">Una riga vuota per andare a capo con un nuovo paragrafo</p></div>
          <div class="field">
            <label for="e-accesso">Accesso</label>
            <select id="e-accesso" name="accesso"><option value="pubblico">Aperto a tutti</option><option value="soci">Solo soci</option></select>
          </div>
          <div class="field">
            <label for="e-ingresso">Ingresso</label>
            <select id="e-ingresso" name="ingresso"><option value="pagamento">A pagamento</option><option value="libero">Libero</option></select>
          </div>
          <div class="field" data-se="pagamento"><label for="e-prezzo">Prezzo (€)</label><input id="e-prezzo" name="prezzo" type="number" min="0.5" step="0.5" inputmode="decimal" /></div>
          <div class="field" data-se="pagamento"><label for="e-prev">Diritto di prevendita (€, facoltativo)</label><input id="e-prev" name="prevendita" type="number" min="0" step="0.1" inputmode="decimal" /><p class="field__hint">Per biglietto, solo online. Vuoto = nessuno</p></div>
          <label class="check" data-se="libero"><input type="checkbox" name="prenotazione" /> <span>Serve la prenotazione (gratuita, con QR)</span></label>
          <div class="field"><label for="e-posti">Posti (vuoto = senza limite)</label><input id="e-posti" name="posti" type="number" min="1" step="1" /></div>
          <div class="field"><label for="e-max">Massimo biglietti per ordine</label><input id="e-max" name="max_per_ordine" type="number" min="1" max="20" value="6" required /></div>
          <div class="field"><label for="e-vendite">Vendita aperta fino a</label><input id="e-vendite" name="vendite_fino_a" type="datetime-local" /><p class="field__hint">Vuoto = fino all’inizio dell’evento</p></div>
          <div class="field">
            <label for="e-album">Album delle foto (dopo l’evento)</label>
            <select id="e-album" name="album_id"><option value="">Nessuno</option></select>
          </div>
        </div>

        <div class="adm-locandina">
          <div class="adm-locandina__img" aria-hidden="true"></div>
          <div>
            <p class="label">Locandina</p>
            <label class="link" for="e-file">Carica un’immagine</label>
            <input id="e-file" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only" />
            <p class="field__hint">Verticale va benissimo. Viene ridimensionata prima del caricamento.</p>
          </div>
        </div>

        <div class="adm-actions">
          <button class="btn" type="submit" name="azione" value="bozza">Salva come bozza</button>
          <button class="btn btn--paper" type="submit" name="azione" value="pubblicato">Salva e pubblica</button>
          <a class="link adm-vedi-evento" target="_blank" hidden>Vedi sul sito ↗</a>
          <button class="link adm-elimina-evento" type="button" hidden>Elimina evento</button>
        </div>
      </form>

      <section class="adm-vendite" hidden>
        <div class="adm-head">
          <h2 class="display h3">Biglietti</h2>
          <div class="adm-actions">
            <button class="btn btn--paper adm-csv-ingresso" type="button">Lista nomi (CSV)</button>
            <button class="link adm-annulla-evento" type="button">Annulla evento e rimborsa tutti</button>
          </div>
        </div>
        <dl class="adm-numeri"></dl>
        <div class="field adm-cerca-ordini"><label for="o-cerca">Cerca</label><input id="o-cerca" type="search" placeholder="Nome, email, telefono" /></div>
        <ul class="adm-ordini"></ul>
      </section>
    </section>

    <!-- ================= ALBUM ================= -->
    <section class="adm-view" data-view="album" hidden>
      <div class="adm-head"><h1 class="display h2">Album</h1></div>
      <form class="adm-card adm-nuovo">
        <h2 class="display h3">Nuovo album</h2>
        <div class="adm-fields">
          <div class="field"><label for="n-titolo">Titolo</label><input id="n-titolo" name="titolo" required maxlength="120" /></div>
          <div class="field"><label for="n-data">Data dell’evento</label><input id="n-data" name="data" type="date" required /></div>
          <div class="field"><label for="n-luogo">Luogo (facoltativo)</label><input id="n-luogo" name="luogo" maxlength="120" /></div>
        </div>
        <button class="btn" type="submit">Crea album</button>
      </form>
      <ul class="adm-lista adm-albums"></ul>
    </section>

    <section class="adm-view" data-view="album-uno" hidden>
      <a class="link" href="#album">← Tutti gli album</a>
      <form class="adm-card adm-meta">
        <div class="adm-fields">
          <div class="field"><label for="m-titolo">Titolo</label><input id="m-titolo" name="titolo" required maxlength="120" /></div>
          <div class="field"><label for="m-data">Data</label><input id="m-data" name="data" type="date" required /></div>
          <div class="field"><label for="m-luogo">Luogo</label><input id="m-luogo" name="luogo" maxlength="120" /></div>
          <div class="field field--wide"><label for="m-descr">Descrizione (facoltativa)</label><input id="m-descr" name="descrizione" maxlength="300" /></div>
        </div>
        <label class="check"><input type="checkbox" name="pubblicato" /> <span>Pubblicato: visibile sul sito</span></label>
        <div class="adm-actions">
          <button class="btn" type="submit">Salva</button>
          <a class="link adm-vedi" target="_blank">Vedi sul sito ↗</a>
          <button class="link adm-elimina-album" type="button">Elimina album</button>
        </div>
      </form>
      <div class="adm-drop" tabindex="0">
        <p class="display h3">Trascina qui le foto</p>
        <p>oppure <label class="link" for="file">scegli dal computer</label>. JPG, PNG o WebP: vengono ridimensionate prima di caricarle.</p>
        <input id="file" type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" />
        <progress class="adm-progress" max="1" value="0" hidden></progress>
        <p class="adm-progress-txt label"></p>
      </div>
      <p class="adm-conteggio label"></p>
      <ol class="adm-foto"></ol>
    </section>

    <!-- ================= COMUNICAZIONI ================= -->
    <section class="adm-view" data-view="comunicazioni" hidden>
      <div class="adm-head"><h1 class="display h2">Comunicazioni</h1></div>
      <p class="body adm-com-conteggio"></p>
      <form class="adm-card adm-com">
        <div class="adm-fields">
          <div class="field field--wide">
            <label for="c-evento">Evento da annunciare (facoltativo)</label>
            <select id="c-evento" name="evento_id"><option value="">Nessuno: solo un messaggio</option></select>
          </div>
          <div class="field field--wide"><label for="c-oggetto">Oggetto</label><input id="c-oggetto" name="oggetto" required maxlength="150" placeholder="Es. Sabato 12: Festa d’inverno, biglietti aperti" /></div>
          <div class="field field--wide"><label for="c-testo">Testo</label><textarea id="c-testo" name="testo" rows="8" required maxlength="10000" placeholder="Scrivi come scriveresti a un amico. Una riga vuota per un nuovo paragrafo. L’email comincia da sola con «Ciao (nome),»."></textarea></div>
        </div>
        <p class="field__hint">Se scegli un evento, sotto il testo compare la sua scheda con la locandina e il bottone “Prendi il biglietto”: il link apre il modulo già compilato con i dati di quel socio.</p>
        <div class="adm-actions">
          <button class="btn btn--paper" type="button" data-com="anteprima">Anteprima</button>
          <div class="field adm-com-prova"><label for="c-prova">Invia una prova a</label><input id="c-prova" type="email" /></div>
          <button class="btn btn--paper" type="button" data-com="prova">Invia la prova</button>
        </div>
        <div class="adm-actions adm-com-invio">
          <button class="btn" type="button" data-com="invia">Invia a tutti i soci</button>
          <progress class="adm-progress adm-com-progress" max="1" value="0" hidden></progress>
          <p class="label adm-com-stato"></p>
        </div>
      </form>
      <iframe class="adm-com-anteprima" title="Anteprima dell’email" hidden></iframe>
      <h2 class="display h3">Inviate</h2>
      <ul class="adm-lista adm-campagne"></ul>
    </section>

    <!-- ================= SOCI ================= -->
    <section class="adm-view" data-view="soci" hidden>
      <div class="adm-head">
        <h1 class="display h2">Soci</h1>
        <div class="adm-actions">
          <button class="btn adm-nuovo-socio" type="button">Aggiungi socio</button>
          <label class="btn btn--paper" for="import-file">Importa lista (Excel o CSV)</label>
          <input id="import-file" type="file" accept=".xlsx,.csv,text/csv" class="sr-only" />
          <button class="btn btn--paper adm-csv" type="button">Scarica libro soci (CSV)</button>
        </div>
      </div>

      <form class="adm-card adm-socio-form" hidden>
        <h2 class="display h3">Aggiungi socio</h2>
        <p class="body">Diventa subito socio attivo, con il numero di tessera successivo. Serve almeno l’email o il telefono.</p>
        <div class="adm-fields">
          <div class="field"><label for="ns-nome">Nome</label><input id="ns-nome" name="nome" required maxlength="120" /></div>
          <div class="field"><label for="ns-cognome">Cognome</label><input id="ns-cognome" name="cognome" required maxlength="120" /></div>
          <div class="field"><label for="ns-nascita">Data di nascita (facoltativa)</label><input id="ns-nascita" name="data_nascita" type="date" /></div>
          <div class="field"><label for="ns-email">Email</label><input id="ns-email" name="email" type="email" maxlength="120" /></div>
          <div class="field"><label for="ns-tel">Telefono</label><input id="ns-tel" name="telefono" type="tel" maxlength="30" /></div>
          <div class="field field--wide"><label for="ns-note">Note (facoltative)</label><input id="ns-note" name="note" maxlength="300" placeholder="Es. tessera fatta all’evento del 12 luglio, pagata in contanti" /></div>
        </div>
        <label class="check"><input type="checkbox" name="benvenuto" checked /> <span>Mandagli l’email di benvenuto con il numero di tessera (se ha l’email)</span></label>
        <div class="adm-actions">
          <button class="btn" type="submit">Aggiungi</button>
          <button class="link adm-socio-annulla" type="button">Annulla</button>
        </div>
      </form>

      <div class="adm-card adm-import" hidden>
        <h2 class="display h3">Importa soci</h2>
        <p class="body adm-import__info"></p>
        <div class="adm-tab-wrap"><table class="adm-tab adm-import__anteprima"></table></div>
        <div class="adm-actions">
          <button class="btn adm-import__ok" type="button">Importa</button>
          <button class="link adm-import__annulla" type="button">Annulla</button>
        </div>
        <div class="adm-import__esito body"></div>
      </div>

      <div class="adm-filtri">
        <div class="field"><label for="s-cerca">Cerca</label><input id="s-cerca" type="search" placeholder="Nome, email, telefono, numero" /></div>
        <div class="field">
          <label for="s-stato">Stato</label>
          <select id="s-stato">
            <option value="attivo">Attivi</option>
            <option value="in_attesa">In attesa di pagamento</option>
            <option value="receduto">Receduti</option>
            <option value="">Tutti</option>
          </select>
        </div>
        <label class="check"><input type="checkbox" id="s-incompleti" /> <span>Solo senza data di nascita</span></label>
      </div>
      <p class="adm-conteggio-soci label"></p>
      <div class="adm-tab-wrap">
        <table class="adm-tab adm-soci">
          <thead><tr><th>N°</th><th>Nome</th><th>Email</th><th>Telefono</th><th>Stato</th><th>Dal</th><th>Comunicazioni</th><th></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>
  </main>
</Base>

<script>
  import { readSheet } from 'read-excel-file/browser';
  import {
    $, api, configurato, esc, euro, fallito, giorno, login, msg, ridimensiona, ruolo, sb, scaricaCsv, slugDa, urlPubblico,
  } from '../../scripts/admin-comune';

  const mostra = (view: string) => {
    document.querySelectorAll<HTMLElement>('.adm-view').forEach((v) => (v.hidden = v.dataset.view !== view));
    document.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.toggleAttribute('aria-current', view.startsWith(t.dataset.tab!)));
  };
  const val = (form: HTMLFormElement, n: string) => (form.elements.namedItem(n) as HTMLInputElement);

  /* ================= session & routing ================= */
  const entra = async () => {
    const r = await ruolo();
    $('.adm-tabs').hidden = r !== 'admin';
    $('.adm-esci').hidden = !r;
    if (!r) return mostra('login');
    if (r === 'ingresso') return location.replace('/admin/ingresso');
    route();
  };
  const route = () => {
    const [view, id] = location.hash.replace('#', '').split('/');
    if (view === 'soci') return caricaSoci();
    if (view === 'comunicazioni') return apriComunicazioni();
    if (view === 'album' && id) return apriAlbum(id);
    if (view === 'album') return elencoAlbum();
    if (view === 'eventi' && id) return apriEvento(id);
    return elencoEventi();
  };

  if (!configurato) mostra('config');
  else {
    $('.adm-login').addEventListener('submit', async (e) => { e.preventDefault(); if (await login(e.target as HTMLFormElement)) entra(); });
    $('.adm-esci').addEventListener('click', async () => { await sb.auth.signOut(); location.hash = ''; entra(); });
    addEventListener('hashchange', () => sb.auth.getSession().then(({ data }) => data.session && route()));
    entra();
  }

  /* ================= EVENTI ================= */
  type Evento = Record<string, any>;
  let evento: Evento | null = null;
  let ordini: any[] = [];

  const elencoEventi = async () => {
    mostra('eventi');
    const { data, error } = await sb.from('eventi').select('id, titolo, data, ora_inizio, stato, posti, accesso, ingresso, prezzo_cent').order('data', { ascending: false });
    if (fallito(error, 'Eventi')) return;
    const oggi = new Date().toISOString().slice(0, 10);
    $('.adm-eventi').innerHTML = (data ?? []).map((e) => `
      <li><a href="#eventi/${e.id}" class="adm-riga">
        <strong>${esc(e.titolo)}</strong>
        <span class="label">${giorno(e.data)} · ${e.ora_inizio.slice(0, 5)} · ${e.ingresso === 'libero' ? 'libero' : euro(e.prezzo_cent)} · ${e.accesso === 'soci' ? 'solo soci' : 'pubblico'}${e.data < oggi ? ' · passato' : ''}</span>
        <span class="adm-badge ${e.stato === 'pubblicato' ? 'is-on' : e.stato === 'annullato' ? 'is-ko' : ''}">${{ bozza: 'Bozza', pubblicato: 'Pubblicato', annullato: 'Annullato' }[e.stato as string]}</span>
      </a></li>`).join('') || '<li class="body">Nessun evento ancora.</li>';
  };

  const formEvento = $<HTMLFormElement>('.adm-evento');
  const aggiornaIngresso = () => {
    const ing = val(formEvento, 'ingresso').value;
    formEvento.querySelectorAll<HTMLElement>('[data-se]').forEach((el) => (el.hidden = el.dataset.se !== ing));
  };
  formEvento.addEventListener('change', aggiornaIngresso);

  const caricaAlbumSelect = async (scelto: string | null) => {
    const { data } = await sb.from('album').select('id, titolo, data').order('data', { ascending: false });
    $('#e-album').innerHTML = '<option value="">Nessuno</option>' + (data ?? []).map((a) => `<option value="${a.id}" ${a.id === scelto ? 'selected' : ''}>${esc(a.titolo)} · ${giorno(a.data)}</option>`).join('');
  };

  const locale = (iso: string | null) => {
    if (!iso) return '';
    const d = new Date(iso);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
  };

  const apriEvento = async (id: string) => {
    mostra('evento');
    formEvento.reset();
    evento = null;
    $('.adm-locandina__img').innerHTML = '';
    $('.adm-vendite').hidden = true;
    $<HTMLAnchorElement>('.adm-vedi-evento').hidden = true;
    $<HTMLButtonElement>('.adm-elimina-evento').hidden = true;
    if (id === 'nuovo') {
      $('.adm-evento__titolo').textContent = 'Nuovo evento';
      await caricaAlbumSelect(null);
      return aggiornaIngresso();
    }
    const { data, error } = await sb.from('eventi').select('*').eq('id', id).single();
    if (fallito(error, 'Evento')) return;
    evento = data;
    $('.adm-evento__titolo').textContent = data.titolo;
    for (const k of ['titolo', 'data', 'luogo_nome', 'luogo_indirizzo', 'descrizione', 'accesso', 'ingresso', 'posti', 'max_per_ordine']) {
      val(formEvento, k).value = data[k] ?? '';
    }
    val(formEvento, 'ora_inizio').value = data.ora_inizio.slice(0, 5);
    val(formEvento, 'ora_fine').value = data.ora_fine.slice(0, 5);
    val(formEvento, 'prezzo').value = data.prezzo_cent ? String(data.prezzo_cent / 100) : '';
    val(formEvento, 'prevendita').value = data.prevendita_cent ? String(data.prevendita_cent / 100) : '';
    val(formEvento, 'prenotazione').checked = data.prenotazione;
    val(formEvento, 'vendite_fino_a').value = locale(data.vendite_fino_a);
    await caricaAlbumSelect(data.album_id);
    aggiornaIngresso();
    if (data.locandina_path) {
      $('.adm-locandina__img').innerHTML = `<img src="${urlPubblico('locandine', data.locandina_path)}" alt="" />`;
    }
    const vedi = $<HTMLAnchorElement>('.adm-vedi-evento');
    vedi.href = `/eventi/${data.slug}`;
    vedi.hidden = data.stato === 'bozza';
    $<HTMLButtonElement>('.adm-elimina-evento').hidden = false;
    await caricaOrdini();
  };

  formEvento.addEventListener('submit', async (e) => {
    e.preventDefault();
    const stato = ((e as SubmitEvent).submitter as HTMLButtonElement | null)?.value ?? 'bozza';
    const f = new FormData(formEvento);
    const s = (k: string) => String(f.get(k) ?? '').trim();
    const ingresso = s('ingresso');
    const riga: Record<string, unknown> = {
      titolo: s('titolo'), data: s('data'), ora_inizio: s('ora_inizio'), ora_fine: s('ora_fine'),
      luogo_nome: s('luogo_nome'), luogo_indirizzo: s('luogo_indirizzo') || null, descrizione: s('descrizione') || null,
      accesso: s('accesso'), ingresso,
      prezzo_cent: ingresso === 'pagamento' ? Math.round(Number(s('prezzo').replace(',', '.')) * 100) || null : null,
      prevendita_cent: ingresso === 'pagamento' ? Math.round(Number(s('prevendita').replace(',', '.')) * 100) || 0 : 0,
      prenotazione: ingresso === 'libero' && f.get('prenotazione') === 'on',
      posti: s('posti') ? Number(s('posti')) : null,
      max_per_ordine: Number(s('max_per_ordine')) || 6,
      vendite_fino_a: s('vendite_fino_a') ? new Date(s('vendite_fino_a')).toISOString() : null,
      album_id: s('album_id') || null,
      stato: evento?.stato === 'annullato' ? 'annullato' : stato,
    };
    if (ingresso === 'pagamento' && !riga.prezzo_cent) return msg('Per un evento a pagamento serve il prezzo (minimo 0,50 €).', true);
    if (evento) {
      const { error } = await sb.from('eventi').update(riga).eq('id', evento.id);
      if (fallito(error, 'Salvataggio')) return;
      msg(stato === 'pubblicato' ? 'Evento salvato e pubblicato. Sul sito si aggiorna entro un minuto.' : 'Evento salvato.');
      apriEvento(evento.id);
    } else {
      let slug = slugDa(String(riga.titolo), String(riga.data));
      const { data: c } = await sb.from('eventi').select('id').eq('slug', slug).maybeSingle();
      if (c) slug += `-${Math.random().toString(36).slice(2, 6)}`;
