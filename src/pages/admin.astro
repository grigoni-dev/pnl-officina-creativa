---
import Base from '../layouts/Base.astro';
---
<Base title="Admin · PNL Officina Creativa" description="Area riservata." noindex>
  <header class="adm-top">
    <div class="wrap adm-top__row">
      <a class="adm-mark" href="/">PNL <span class="label">Admin</span></a>
      <nav class="adm-tabs" aria-label="Sezioni" hidden>
        <a href="#album" data-tab="album">Album</a>
        <a href="#soci" data-tab="soci">Soci</a>
      </nav>
      <button class="adm-esci link" type="button" hidden>Esci</button>
    </div>
  </header>

  <main id="contenuto" class="wrap adm">
    <p class="adm-msg" role="status" aria-live="polite"></p>

    <!-- login -->
    <section class="adm-view" data-view="login" hidden>
      <h1 class="display h2">Area riservata</h1>
      <form class="adm-login">
        <div class="field"><label for="l-email">Email</label><input id="l-email" name="email" type="email" autocomplete="username" required /></div>
        <div class="field"><label for="l-pw">Password</label><input id="l-pw" name="password" type="password" autocomplete="current-password" required /></div>
        <button class="btn" type="submit">Entra</button>
      </form>
    </section>

    <section class="adm-view" data-view="config" hidden>
      <h1 class="display h2">Supabase non collegato</h1>
      <p class="body">Mancano PUBLIC_SUPABASE_URL e PUBLIC_SUPABASE_ANON_KEY. Vedi SETUP.md.</p>
    </section>

    <!-- album list -->
    <section class="adm-view" data-view="album" hidden>
      <div class="adm-head">
        <h1 class="display h2">Album</h1>
      </div>
      <form class="adm-card adm-nuovo">
        <h2 class="display h3">Nuovo album</h2>
        <div class="adm-fields">
          <div class="field"><label for="n-titolo">Titolo</label><input id="n-titolo" name="titolo" required maxlength="120" /></div>
          <div class="field"><label for="n-data">Data dell’evento</label><input id="n-data" name="data" type="date" required /></div>
          <div class="field"><label for="n-luogo">Luogo (facoltativo)</label><input id="n-luogo" name="luogo" maxlength="120" /></div>
        </div>
        <button class="btn" type="submit">Crea album</button>
      </form>
      <ul class="adm-albums"></ul>
    </section>

    <!-- one album -->
    <section class="adm-view" data-view="album-uno" hidden>
      <a class="link" href="#album">← Tutti gli album</a>
      <form class="adm-card adm-meta">
        <div class="adm-fields">
          <div class="field"><label for="m-titolo">Titolo</label><input id="m-titolo" name="titolo" required maxlength="120" /></div>
          <div class="field"><label for="m-data">Data</label><input id="m-data" name="data" type="date" required /></div>
          <div class="field"><label for="m-luogo">Luogo</label><input id="m-luogo" name="luogo" maxlength="120" /></div>
          <div class="field field--wide"><label for="m-descr">Descrizione (facoltativa)</label><input id="m-descr" name="descrizione" maxlength="300" /></div>
        </div>
        <label class="check"><input type="checkbox" name="pubblicato" /> <span>Pubblicato: visibile sul sito</span></label>
        <div class="adm-actions">
          <button class="btn" type="submit">Salva</button>
          <a class="link adm-vedi" target="_blank">Vedi sul sito ↗</a>
          <button class="link adm-elimina-album" type="button">Elimina album</button>
        </div>
      </form>

      <div class="adm-drop" tabindex="0">
        <p class="display h3">Trascina qui le foto</p>
        <p>oppure <label class="link" for="file">scegli dal computer</label>. JPG, PNG o WebP: vengono ridimensionate prima di caricarle.</p>
        <input id="file" type="file" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" />
        <progress class="adm-progress" max="1" value="0" hidden></progress>
        <p class="adm-progress-txt label"></p>
      </div>

      <p class="adm-conteggio label"></p>
      <ol class="adm-foto"></ol>
    </section>

    <!-- members -->
    <section class="adm-view" data-view="soci" hidden>
      <div class="adm-head">
        <h1 class="display h2">Soci</h1>
        <button class="btn btn--paper adm-csv" type="button">Scarica libro soci (CSV)</button>
      </div>
      <div class="adm-filtri">
        <div class="field"><label for="s-cerca">Cerca</label><input id="s-cerca" type="search" placeholder="Nome, email, codice fiscale, numero" /></div>
        <div class="field">
          <label for="s-stato">Stato</label>
          <select id="s-stato">
            <option value="attivo">Attivi</option>
            <option value="in_attesa">In attesa di pagamento</option>
            <option value="receduto">Receduti</option>
            <option value="">Tutti</option>
          </select>
        </div>
      </div>
      <p class="adm-conteggio-soci label"></p>
      <div class="adm-tab-wrap">
        <table class="adm-tab">
          <thead><tr><th>N°</th><th>Nome</th><th>Email</th><th>Codice fiscale</th><th>Stato</th><th>Dal</th><th></th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </section>
  </main>
</Base>

<script>
  import { createClient, type SupabaseClient } from '@supabase/supabase-js';
  import { PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';

  type Album = { id: string; slug: string; titolo: string; data: string; luogo: string | null; descrizione: string | null; pubblicato: boolean; copertina_id: string | null; foto: { count: number }[] };
  type Foto = { id: string; path: string; thumb_path: string; ordine: number };
  type Socio = Record<string, any>;

  const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const urlFoto = (p: string) => `${PUBLIC_SUPABASE_URL}/storage/v1/object/public/album/${p}`;
  const msg = (t: string, errore = false) => {
    const m = $('.adm-msg');
    m.textContent = t;
    m.classList.toggle('is-errore', errore);
    if (t) setTimeout(() => { if (m.textContent === t) m.textContent = ''; }, 6000);
  };
  const fallito = (e: { message?: string } | null, cosa: string) => {
    if (!e) return false;
    console.error(cosa, e);
    msg(`${cosa}: ${e.message ?? 'errore'}`, true);
    return true;
  };
  const mostra = (view: string) => {
    document.querySelectorAll<HTMLElement>('.adm-view').forEach((v) => (v.hidden = v.dataset.view !== view));
    document.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => t.toggleAttribute('aria-current', view.startsWith(t.dataset.tab!)));
  };
  const slugDa = (titolo: string, data: string) =>
    `${data.slice(0, 7)}-${titolo}`.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80);
  const giorno = (d: string | null) => (d ? new Date(d).toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric' }) : '');

  if (!PUBLIC_SUPABASE_URL || !PUBLIC_SUPABASE_ANON_KEY) {
    mostra('config');
  } else {
    const sb: SupabaseClient = createClient(PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY);

    /* ---------------- session ---------------- */
    const entra = async () => {
      const { data } = await sb.auth.getSession();
      const loggato = !!data.session;
      $('.adm-tabs').hidden = !loggato;
      $('.adm-esci').hidden = !loggato;
      if (!loggato) return mostra('login');
      const { data: admin } = await sb.from('admins').select('user_id').eq('user_id', data.session!.user.id).maybeSingle();
      if (!admin) {
        msg('Questo account non è tra gli admin. Chiedi di essere aggiunto alla tabella admins.', true);
        await sb.auth.signOut();
        return entra();
      }
      route();
    };
    $('.adm-login').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(e.target as HTMLFormElement);
      const { error } = await sb.auth.signInWithPassword({ email: String(f.get('email')), password: String(f.get('password')) });
      if (error) return msg('Email o password sbagliate.', true);
      entra();
    });
    $('.adm-esci').addEventListener('click', async () => { await sb.auth.signOut(); location.hash = ''; entra(); });

    /* ---------------- routing ---------------- */
    const route = () => {
      const [view, id] = location.hash.replace('#', '').split('/');
      if (view === 'soci') return caricaSoci();
      if (view === 'album' && id) return apriAlbum(id);
      return elencoAlbum();
    };
    addEventListener('hashchange', () => sb.auth.getSession().then(({ data }) => data.session && route()));

    /* ---------------- albums ---------------- */
    const elencoAlbum = async () => {
      mostra('album');
      const { data, error } = await sb.from('album').select('*, foto:foto!foto_album_id_fkey(count)').order('data', { ascending: false });
      if (fallito(error, 'Caricamento album')) return;
      const lista = $('.adm-albums');
      lista.innerHTML = (data as Album[]).length
        ? (data as Album[]).map((a) => `
          <li><a href="#album/${a.id}" class="adm-album">
            <strong>${esc(a.titolo)}</strong>
            <span class="label">${giorno(a.data)} · ${a.foto[0]?.count ?? 0} foto</span>
            <span class="adm-badge ${a.pubblicato ? 'is-on' : ''}">${a.pubblicato ? 'Pubblicato' : 'Bozza'}</span>
          </a></li>`).join('')
        : '<li class="body">Nessun album ancora. Creane uno qui sopra.</li>';
    };

    $('.adm-nuovo').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target as HTMLFormElement;
      const f = new FormData(form);
      const titolo = String(f.get('titolo')).trim();
      const data = String(f.get('data'));
      let slug = slugDa(titolo, data);
      const { data: esiste } = await sb.from('album').select('id').eq('slug', slug).maybeSingle();
      if (esiste) slug = `${slug}-${Math.random().toString(36).slice(2, 6)}`;
      const { data: nuovo, error } = await sb.from('album')
        .insert({ titolo, data, luogo: String(f.get('luogo')).trim() || null, slug })
        .select('id').single();
      if (fallito(error, 'Creazione album')) return;
      form.reset();
      location.hash = `album/${nuovo!.id}`;
    });

    let corrente: Album | null = null;
    let fotoCorrenti: Foto[] = [];

    const apriAlbum = async (id: string) => {
      mostra('album-uno');
      const { data, error } = await sb.from('album').select('*, foto:foto!foto_album_id_fkey(count)').eq('id', id).single();
      if (fallito(error, 'Album')) return;
      corrente = data as Album;
      const form = $<HTMLFormElement>('.adm-meta');
      (form.elements.namedItem('titolo') as HTMLInputElement).value = corrente.titolo;
      (form.elements.namedItem('data') as HTMLInputElement).value = corrente.data;
      (form.elements.namedItem('luogo') as HTMLInputElement).value = corrente.luogo ?? '';
      (form.elements.namedItem('descrizione') as HTMLInputElement).value = corrente.descrizione ?? '';
      (form.elements.namedItem('pubblicato') as HTMLInputElement).checked = corrente.pubblicato;
      $<HTMLAnchorElement>('.adm-vedi').href = `/eventi/${corrente.slug}`;
      await caricaFoto();
    };

    const caricaFoto = async () => {
      if (!corrente) return;
      const { data, error } = await sb.from('foto').select('id, path, thumb_path, ordine').eq('album_id', corrente.id).order('ordine').order('created_at');
      if (fallito(error, 'Foto')) return;
      fotoCorrenti = data as Foto[];
      $('.adm-conteggio').textContent = `${fotoCorrenti.length} foto`;
      $('.adm-foto').innerHTML = fotoCorrenti.map((f) => `
        <li class="${f.id === corrente!.copertina_id ? 'is-cover' : ''}">
          <img src="${urlFoto(f.thumb_path)}" alt="" loading="lazy" />
          <div class="adm-foto__az">
            ${f.id === corrente!.copertina_id ? '<span class="label">Copertina</span>' : `<button type="button" class="link" data-cover="${f.id}">Copertina</button>`}
            <button type="button" class="link" data-del="${f.id}">Elimina</button>
          </div>
        </li>`).join('');
    };

    $('.adm-meta').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!corrente) return;
      const f = new FormData(e.target as HTMLFormElement);
      const { error } = await sb.from('album').update({
        titolo: String(f.get('titolo')).trim(),
        data: String(f.get('data')),
        luogo: String(f.get('luogo')).trim() || null,
        descrizione: String(f.get('descrizione')).trim() || null,
        pubblicato: f.get('pubblicato') === 'on',
      }).eq('id', corrente.id);
      if (fallito(error, 'Salvataggio')) return;
      msg('Album salvato. Sul sito si aggiorna entro un minuto.');
    });

    $('.adm-foto').addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      if (!corrente) return;
      if (t.dataset.cover) {
        const { error } = await sb.from('album').update({ copertina_id: t.dataset.cover }).eq('id', corrente.id);
        if (fallito(error, 'Copertina')) return;
        corrente.copertina_id = t.dataset.cover;
        caricaFoto();
      }
      if (t.dataset.del) {
        const f = fotoCorrenti.find((x) => x.id === t.dataset.del);
        if (!f || !confirm('Eliminare questa foto?')) return;
        const { error } = await sb.from('foto').delete().eq('id', f.id);
        if (fallito(error, 'Eliminazione')) return;
        await sb.storage.from('album').remove([f.path, f.thumb_path]);
        if (corrente.copertina_id === f.id) corrente.copertina_id = null;
        caricaFoto();
      }
    });

    $('.adm-elimina-album').addEventListener('click', async () => {
      if (!corrente) return;
      if (!confirm(`Eliminare l’album “${corrente.titolo}” e tutte le sue ${fotoCorrenti.length} foto? Non si può annullare.`)) return;
      const percorsi = fotoCorrenti.flatMap((f) => [f.path, f.thumb_path]);
      for (let i = 0; i < percorsi.length; i += 900) await sb.storage.from('album').remove(percorsi.slice(i, i + 900));
      const { error } = await sb.from('album').delete().eq('id', corrente.id);
      if (fallito(error, 'Eliminazione album')) return;
      msg('Album eliminato.');
      location.hash = 'album';
    });

    /* ---------------- upload ---------------- */
    // Resize in the browser before uploading: a large webp plus a thumbnail.
    const ridimensiona = async (img: ImageBitmap, lato: number, qualita: number) => {
      const s = Math.min(1, lato / Math.max(img.width, img.height));
      const w = Math.round(img.width * s), h = Math.round(img.height * s);
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const ctx = c.getContext('2d')!;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, 0, 0, w, h);
      let blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/webp', qualita));
      if (!blob || blob.type !== 'image/webp') blob = await new Promise<Blob | null>((r) => c.toBlob(r, 'image/jpeg', qualita + 0.05));
      if (!blob) throw new Error('conversione non riuscita');
      return { blob, w, h, ext: blob.type === 'image/webp' ? 'webp' : 'jpg' };
    };

    const carica = async (files: File[]) => {
      if (!corrente || !files.length) return;
      const album = corrente;
      files.sort((a, b) => a.name.localeCompare(b.name, 'it', { numeric: true }));
      const base = fotoCorrenti.reduce((m, f) => Math.max(m, f.ordine), 0) + 1;
      const prog = $<HTMLProgressElement>('.adm-progress');
      const txt = $('.adm-progress-txt');
      prog.hidden = false; prog.max = files.length; prog.value = 0;
      const falliti: string[] = [];
      let primo: string | null = null;
      let primoIdx = Infinity;
      let prossimo = 0;

      const lavora = async () => {
        while (prossimo < files.length) {
          const i = prossimo++;
          const file = files[i];
          try {
            const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' });
            const [g, t] = [await ridimensiona(bmp, 2048, 0.82), await ridimensiona(bmp, 640, 0.72)];
            bmp.close();
            const id = crypto.randomUUID();
            const path = `${album.id}/${id}.${g.ext}`, thumb = `${album.id}/${id}-t.${t.ext}`;
            const opt = { cacheControl: '31536000', upsert: false };
            const [u1, u2] = await Promise.all([
              sb.storage.from('album').upload(path, g.blob, { ...opt, contentType: g.blob.type }),
              sb.storage.from('album').upload(thumb, t.blob, { ...opt, contentType: t.blob.type }),
            ]);
            if (u1.error || u2.error) throw u1.error ?? u2.error;
            const { data: riga, error } = await sb.from('foto').insert({
              album_id: album.id, path, thumb_path: thumb, width: g.w, height: g.h, thumb_width: t.w, thumb_height: t.h, ordine: base + i,
            }).select('id').single();
            if (error) throw error;
            if (i < primoIdx) { primoIdx = i; primo = riga.id; }
          } catch (err) {
            console.error(file.name, err);
            falliti.push(file.name);
          }
          prog.value += 1;
          txt.textContent = `${prog.value} di ${files.length}`;
        }
      };
      await Promise.all([lavora(), lavora(), lavora()]);

      if (!album.copertina_id && primo) {
        await sb.from('album').update({ copertina_id: primo }).eq('id', album.id);
        album.copertina_id = primo;
      }
      prog.hidden = true;
      txt.textContent = '';
      msg(falliti.length
        ? `Caricate ${files.length - falliti.length} foto. Non riuscite: ${falliti.join(', ')} (formato non supportato? Le HEIC dell’iPhone vanno prima convertite in JPG).`
        : `Caricate ${files.length} foto.`, falliti.length > 0);
      caricaFoto();
    };

    const drop = $('.adm-drop');
    $<HTMLInputElement>('#file').addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      carica([...(input.files ?? [])]);
      input.value = '';
    });
    drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('is-over'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('is-over');
      carica([...(e.dataTransfer?.files ?? [])].filter((f) => f.type.startsWith('image/')));
    });

    /* ---------------- members ---------------- */
    let soci: Socio[] = [];
    const STATI: Record<string, string> = { attivo: 'Attivo', in_attesa: 'In attesa', receduto: 'Receduto' };

    const caricaSoci = async () => {
      mostra('soci');
      const { data, error } = await sb.from('soci').select('*').order('numero', { ascending: true, nullsFirst: false }).order('created_at');
      if (fallito(error, 'Soci')) return;
      soci = data ?? [];
      disegnaSoci();
    };

    const filtrati = () => {
      const q = $<HTMLInputElement>('#s-cerca').value.trim().toLowerCase();
      const st = $<HTMLSelectElement>('#s-stato').value;
      return soci.filter((s) => (!st || s.stato === st) &&
        (!q || [s.nome, s.cognome, s.email, s.codice_fiscale, s.numero].join(' ').toLowerCase().includes(q)));
    };

    const disegnaSoci = () => {
      const righe = filtrati();
      $('.adm-conteggio-soci').textContent = `${righe.length} su ${soci.length}`;
      $('.adm-tab tbody').innerHTML = righe.map((s) => `
        <tr>
          <td>${s.numero ?? '—'}</td>
          <td>${esc(s.nome)} ${esc(s.cognome)}</td>
          <td>${esc(s.email)}</td>
          <td>${esc(s.codice_fiscale)}</td>
          <td><span class="adm-badge ${s.stato === 'attivo' ? 'is-on' : ''}">${STATI[s.stato]}</span></td>
          <td>${giorno(s.pagato_at ?? s.created_at)}</td>
          <td>${s.stato === 'attivo' ? `<button type="button" class="link" data-recesso="${s.id}">Registra recesso</button>` : ''}</td>
        </tr>`).join('') || '<tr><td colspan="7">Nessun socio.</td></tr>';
    };
    $('#s-cerca').addEventListener('input', disegnaSoci);
    $('#s-stato').addEventListener('change', disegnaSoci);

    $('.adm-tab').addEventListener('click', async (e) => {
      const id = (e.target as HTMLElement).dataset.recesso;
      const s = soci.find((x) => x.id === id);
      if (!s || !confirm(`Registrare il recesso di ${s.nome} ${s.cognome} (tessera N° ${s.numero})?`)) return;
      const { error } = await sb.rpc('registra_recesso', { p_socio: s.id });
      if (fallito(error, 'Recesso')) return;
      msg('Recesso registrato.');
      caricaSoci();
    });

    $('.adm-csv').addEventListener('click', () => {
      const col = ['numero', 'stato', 'cognome', 'nome', 'data_nascita', 'luogo_nascita', 'codice_fiscale', 'indirizzo', 'cap', 'comune', 'provincia', 'email', 'telefono', 'pagato_at', 'receduto_at', 'consenso_privacy_at'];
      const cella = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
      const csv = [col.join(';'), ...soci.filter((s) => s.stato !== 'in_attesa').map((s) => col.map((c) => cella(s[c])).join(';'))].join('\r\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' }));
      a.download = `libro-soci-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
    });

    entra();
  }
</script>

<style>
  .adm-top [hidden], .adm [hidden] { display: none !important; }
  .adm-top { border-bottom: var(--rule) solid var(--blue); }
  .adm-top__row { display: flex; align-items: center; gap: 32px; min-height: 64px; }
  .adm-mark { font-stretch: 125%; font-weight: 900; font-size: 1.6rem; text-decoration: none; letter-spacing: -0.03em; }
  .adm-mark .label { font-stretch: 100%; letter-spacing: 0.06em; font-size: 0.75rem; margin-left: 6px; }
  .adm-tabs { display: flex; gap: 24px; margin-right: auto; }
  .adm-tabs a { font-weight: 700; text-decoration: none; padding-block: 6px; }
  .adm-tabs a[aria-current] { box-shadow: inset 0 -3px var(--blue); }
  .adm-esci { border: 0; background: none; color: inherit; font: inherit; cursor: pointer; margin-left: auto; }
  .adm-tabs:not([hidden]) + .adm-esci { margin-left: 0; }

  .adm { padding-block: 32px 96px; display: grid; gap: 24px; }
  .adm-msg { min-height: 1.5em; font-weight: 700; }
  .adm-msg.is-errore { color: var(--overprint); background: color-mix(in srgb, var(--pink) 30%, transparent); padding: 8px 12px; }
  .adm-view { display: grid; gap: 28px; align-content: start; }
