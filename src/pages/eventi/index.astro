---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Reg from '../../components/Reg.astro';
import EventoScheda from '../../components/EventoScheda.astro';
import { prossimiEventi } from '../../lib/eventi';
import { cachePubblica } from '../../lib/sito';

export const prerender = false;
const eventi = await prossimiEventi(Astro.url.searchParams.get('demo'));
cachePubblica(Astro.response.headers);
---
<Base title="Prossimi eventi · PNL Officina Creativa" description="I prossimi eventi di PNL Officina Creativa: date, orari, luoghi e biglietti.">
  <Nav />
  <main id="contenuto" class="evs">
    <div class="wrap">
      <header class="evs__head">
        <Reg as="h1" class="display h1" text="Prossimi eventi" />
      </header>
      {eventi.length === 0 && (
        <div class="evs__vuoto">
          <p class="lede">Nessun evento in programma, per ora. Il prossimo lo annunciamo qui e sui social.</p>
          <a class="btn btn--paper" href="/album">Guarda le foto di quelli passati</a>
        </div>
      )}
      {eventi.length === 1 && <EventoScheda evento={eventi[0]} grande />}
      {eventi.length > 1 && eventi.map((e) => <EventoScheda evento={e} />)}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .evs { padding-block: clamp(36px, 5vw, 72px) clamp(72px, 10vw, 144px); }
  .evs__head { padding-bottom: clamp(28px, 3.5vw, 48px); }
  .evs__vuoto { display: grid; gap: 28px; justify-items: start; border-top: var(--rule) solid var(--blue); padding-top: 28px; }
</style>
