---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Reg from '../../components/Reg.astro';
import Campo from '../../components/Campo.astro';
import { contatti, quota, statuto as urlStatuto } from '../../data/site';
import { gruppiSocio } from '../../lib/campi-socio';
import { CAMPI, GiaSocio, RichiestaInCorso, inviaRichiesta, leggiModulo, valida, type DatiSocio, type Errori } from '../../lib/soci';
import { entroIlLimite, impronta } from '../../lib/limiti';
import { NonConfigurato } from '../../lib/supabase';
import { indirizzoSito } from '../../lib/sito';

export const prerender = false;

let dati = Object.fromEntries(CAMPI.map((c) => [c, ''])) as DatiSocio;
let privacy = false;
let statuto = false;
let errori: Errori = {};

if (Astro.request.method === 'POST') {
  const letto = leggiModulo(await Astro.request.formData());
  ({ dati, privacy, statuto } = letto);
  errori = valida(letto);
  if (!Object.keys(errori).length) {
    try {
      const chi = await impronta(Astro.request, Astro.clientAddress);
      if (!(await entroIlLimite(`iscrizione:${chi}`, 8, 3600))) {
        errori.generale = 'Troppi tentativi da questa connessione. Riprova tra un’ora o scrivici.';
      } else {
        await inviaRichiesta(dati, indirizzoSito(Astro.url));
        return Astro.redirect('/tesseramento/inviata', 303);
      }
    } catch (err) {
      if (err instanceof GiaSocio) {
        errori.gia = 'Con questa email o questo telefono risulti già socio: non serve fare una nuova richiesta.';
      } else if (err instanceof RichiestaInCorso) {
        errori.gia = 'Abbiamo già una richiesta con questa email o questo telefono: la stiamo valutando e ti scriviamo noi.';
      } else {
        console.error('tesseramento', err);
        errori.generale = err instanceof NonConfigurato
          ? 'Le richieste online non sono ancora attive. Scrivici e ti iscriviamo noi.'
          : 'Qualcosa è andato storto dal nostro lato. Riprova tra poco o scrivici.';
      }
    }
  }
  Astro.response.status = Object.keys(errori).length ? 422 : 200;
} else {
  // prefill from the card on the home page ("Nome e cognome" + email)
  const q = Astro.url.searchParams;
  const pieno = (q.get('nome') ?? '').trim().split(/\s+/);
  dati.nome = pieno[0] ?? '';
  dati.cognome = pieno.slice(1).join(' ');
  dati.email = (q.get('email') ?? '').trim();
}
const nErrori = Object.keys(errori).filter((k) => k !== 'generale' && k !== 'gia').length;

const gruppi = gruppiSocio();
---
<Base title={`Tessera associativa · PNL Officina Creativa`} description={`Chiedi di diventare socio di PNL Officina Creativa: ${quota.importo} €, una volta sola.`}>
  <Nav />
  <main id="contenuto" class="modulo">
    <div class="wrap modulo__grid">
      <header class="modulo__head">
        <Reg as="h1" class="display h2" text="Tessera associativa" />
        <p class="lede">{quota.importo}&nbsp;€, una volta sola. Mandi la richiesta, noi la approviamo e la tessera ti arriva per email. Vale finché non chiedi il recesso.</p>
        <ol class="modulo__passi label">
          <li class="is-qui">1 · La richiesta</li>
          <li>2 · La approviamo</li>
          <li>3 · La tessera</li>
        </ol>
      </header>

      <form class="modulo__form" method="post" novalidate>
        {errori.gia && <p class="avviso avviso--errore" role="alert" tabindex="-1" id="riepilogo-errori">{errori.gia} <a class="link" href="/verifica">Verifica la tessera</a></p>}
        {errori.generale && <p class="avviso avviso--errore" role="alert">{errori.generale} <a class="link" href={`mailto:${contatti.email}`}>{contatti.email}</a></p>}
        {nErrori > 0 && <p class="avviso avviso--errore" role="alert" tabindex="-1" id="riepilogo-errori">Controlla {nErrori === 1 ? 'il campo segnato' : `i ${nErrori} campi segnati`} qui sotto.</p>}

        {gruppi.map((g) => (
          <fieldset class="gruppo">
            <legend class="display h3">{g.titolo}</legend>
            <div class="gruppo__campi">
              {g.campi.map((f) => <Campo def={f} value={dati[f.nome as keyof typeof dati]} errore={errori[f.nome]} />)}
            </div>
          </fieldset>
        ))}

        <fieldset class="gruppo">
          <legend class="display h3">Consensi</legend>
          <div class="consensi">
            <label class:list={['check', errori.statuto && 'check--errore']}>
              <input type="checkbox" name="statuto" value="si" checked={statuto} required aria-invalid={errori.statuto ? 'true' : undefined} />
              <span>Chiedo di diventare socio di PNL Officina Creativa e accetto lo <a class="link" href={urlStatuto} target="_blank">statuto dell’associazione</a>.</span>
            </label>
            {errori.statuto && <p class="field__err">{errori.statuto}</p>}
            <label class:list={['check', errori.privacy && 'check--errore']}>
              <input type="checkbox" name="privacy" value="si" checked={privacy} required aria-invalid={errori.privacy ? 'true' : undefined} />
              <span>Ho letto l’<a class="link" href="/privacy" target="_blank">informativa privacy</a> e acconsento al trattamento dei miei dati per la gestione del libro soci.</span>
            </label>
            {errori.privacy && <p class="field__err">{errori.privacy}</p>}
          </div>
        </fieldset>

        <div class="paga">
          <p class="display paga__importo" aria-hidden="true">{quota.importo}&nbsp;€</p>
          <div class="paga__testo">
            <button class="btn paga__btn" type="submit">Invia la richiesta</button>
            <p class="paga__note">Non paghi niente adesso. Quando approviamo la richiesta ti scriviamo; la quota di {quota.importo}&nbsp;€ la paghi a noi, una volta sola.</p>
          </div>
        </div>
      </form>
    </div>
  </main>
  <Footer />
</Base>

<script>
  // After a failed submit, move focus to the summary so screen readers announce it.
  document.getElementById('riepilogo-errori')?.focus();
  // Avoid double submits.
  const form = document.querySelector<HTMLFormElement>('.modulo__form');
  form?.addEventListener('submit', () => {
    const b = form.querySelector<HTMLButtonElement>('.paga__btn');
    if (b) { b.disabled = true; b.textContent = 'Un attimo…'; }
  });
</script>


