---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reg from '../components/Reg.astro';
import Print from '../components/Print.astro';
import AlbumCard from '../components/AlbumCard.astro';
import { contatti, fotoHero, quota, slogan } from '../data/site';
import EventoScheda from '../components/EventoScheda.astro';
import { elencoAlbum } from '../lib/album';
import { prossimiEventi } from '../lib/eventi';
import { cachePubblica } from '../lib/sito';

export const prerender = false;
const [ultimi, eventi] = await Promise.all([elencoAlbum(3), prossimiEventi(Astro.url.searchParams.get('demo'))]);
cachePubblica(Astro.response.headers);
const social = [
  { nome: 'Instagram', url: contatti.instagram },
  { nome: 'Facebook', url: contatti.facebook },
  { nome: 'TikTok', url: contatti.tiktok },
].filter((s) => s.url);
// the slogan with its punchline marked: "fare schifo" prints as a pink flood
const [prima, dopo] = slogan.split('fare schifo');
---
<Base
  title="PNL Officina Creativa"
  description={`${slogan} PNL Officina Creativa: un gruppo di persone creative a cui piace divertirsi e far divertire.`}
>
  <Nav />

  <main id="contenuto">
    <!-- HERO: the slogan, and one photo -->
    <section class="hero" aria-labelledby="hero-t">
      <div class="wrap hero__grid">
        <h1 id="hero-t" class="display hero__title reg">
          <span class="reg__blue">{prima}<mark class="hero__mark">fare schifo</mark>{dopo}</span>
          <span class="reg__pink" aria-hidden="true">{prima}<mark class="hero__mark hero__mark--ghost">fare schifo</mark>{dopo}</span>
        </h1>
        <p class="label hero__colophon">PNL Officina Creativa · Associazione culturale</p>
        <Print
          foto={fotoHero}
          class="hero__photo reg-host"
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 760px) 100vw, 36vw"
          loading="eager"
        />
      </div>
    </section>

    <!-- PROSSIMI EVENTI: only when there is one -->
    {eventi.length > 0 && (
      <section class="prossimi" id="eventi" aria-labelledby="prossimi-t">
        <div class="wrap">
          <div class="prossimi__head">
            <Reg id="prossimi-t" class="display h2" text={eventi.length === 1 ? 'Prossimo evento' : 'Prossimi eventi'} />
            {eventi.length > 2 && <a class="link" href="/eventi">Tutti gli eventi →</a>}
          </div>
          {eventi.length === 1
            ? <EventoScheda evento={eventi[0]} grande titoloTag="h3" />
            : eventi.slice(0, 2).map((e) => <EventoScheda evento={e} titoloTag="h3" />)}
        </div>
      </section>
    )}

    <!-- CHI SIAMO: one sentence -->
    <section class="chi" id="chi-siamo" aria-labelledby="chi-t">
      <div class="wrap chi__grid">
        <h2 id="chi-t" class="label chi__label">Chi siamo</h2>
        <p class="display chi__text">
          Siamo un gruppo di persone creative a cui piace divertirsi. <span class="chi__alt">E far divertire.</span>
        </p>
      </div>
    </section>

    <!-- ALBUM: one stack of prints per event -->
    <section class="archivio" id="album" aria-labelledby="archivio-t">
      <div class="wrap">
        <div class="archivio__head">
          <Reg id="archivio-t" class="display h2" text="Gli album" />
          <a class="link" href="/album">Tutti gli album →</a>
        </div>
        {ultimi.length === 0 && <p class="lede">Il primo album arriva dopo il prossimo evento.</p>}
        <ol class="archivio__strip">
          {ultimi.map((a) => (
            <li><AlbumCard album={a} sizes="(max-width: 760px) 72vw, (max-width: 1080px) 40vw, 30vw" /></li>
          ))}
        </ol>
      </div>
    </section>

    <!-- TESSERA: pink flood with the card on it -->
    <section class="tessera-sec" id="tessera" aria-labelledby="tessera-t">
      <div class="wrap tessera-sec__grid">
        <div class="tessera-sec__copy">
          <h2 id="tessera-t" class="display h2">Diventa socio</h2>
          <p class="lede">5&nbsp;€, una volta sola. Paghi online con la carta e la tessera ti arriva per email.</p>
        </div>

        <form class="tessera reg-host" action="/tesseramento" method="get" aria-labelledby="tessera-titolo" data-hides-actionbar>
          <div class="tessera__head">
            <p class="label" id="tessera-titolo">Tessera socio N° ____</p>
            <p class="label">Una volta sola</p>
          </div>
          <p class="tessera__name reg" aria-hidden="true">
            <span class="reg__blue" data-print-name>Il tuo nome qui</span><span class="reg__pink" data-print-name>Il tuo nome qui</span>
          </p>
          <p class="display tessera__price" aria-label={`Quota: ${quota.importo} euro`}>{quota.importo}&nbsp;{quota.valuta}</p>
          <div class="tessera__fields">
            <div class="field">
              <label for="h-nome">Nome e cognome</label>
              <input id="h-nome" name="nome" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="h-email">Email</label>
              <input id="h-email" name="email" type="email" autocomplete="email" inputmode="email" required />
            </div>
          </div>
          <button class="btn tessera__go" type="submit">Diventa socio</button>
        </form>

        <form class="verifica" action="/verifica" method="get">
            <div class="field">
              <label for="v-num">Hai già la tessera? Email o telefono</label>
              <input id="v-num" name="contatto" type="text" autocomplete="email" required />
            </div>
            <button class="btn btn--paper" type="submit">Verifica</button>
          </form>
      </div>
    </section>

    <!-- CONTATTI -->
    <section class="contatti" id="contatti" aria-labelledby="contatti-t">
      <div class="wrap contatti__in reg-host">
        <Reg id="contatti-t" class="display h2" text="Scrivici" />
        <p class="lede">Per suonare, collaborare, darci una mano o solo per dire ciao.</p>
        <a class="contatti__mail" href={`mailto:${contatti.email}`}>{contatti.email}</a>
        {contatti.emailProvvisoria && <span class="stamp stamp--inline">Indirizzo provvisorio</span>}
        {social.length > 0 && (
          <ul class="contatti__social">
            {social.map((s) => <li><a class="link" href={s.url!} rel="me">{s.nome}</a></li>)}
          </ul>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  // Typing your name prints it on the tessera, on both plates.
  const input = document.getElementById('h-nome') as HTMLInputElement | null;
  const line = document.querySelector<HTMLElement>('.tessera__name');
  if (input && line) {
    const slots = line.querySelectorAll<HTMLElement>('[data-print-name]');
    const empty = slots[0]?.textContent ?? '';
    const print = () => {
      const v = input.value.trim();
      slots.forEach((s) => (s.textContent = v || empty));
      line.classList.toggle('is-empty', !v);
    };
    input.addEventListener('input', print);
    print();
  }
</script>

<style is:global>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(24px, 3vw, 44px) clamp(48px, 6vw, 88px); }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: 1fr auto;
    gap: 24px clamp(16px, 2vw, 32px);
    min-height: calc(100svh - 79px - clamp(24px, 3vw, 44px) - clamp(48px, 6vw, 88px));
  }
  .hero__title {
    grid-column: 1 / 9;
    grid-row: 1;
    align-self: center;
    font-size: clamp(2.3rem, 0.9rem + 4.6vw, 5.4rem);
    line-height: 0.92;
  }
  .hero__mark { background: var(--pink); color: var(--overprint); padding: 0 0.08em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .hero__mark--ghost { background: transparent; color: inherit; }
  .hero__title .reg__pink { animation: print-pass 900ms var(--ease-out) both; }
  @keyframes print-pass {
    from { transform: translate(0.2em, 0.12em); }
    to { transform: translate(var(--mis-x), var(--mis-y)); }
  }
  .hero__colophon { grid-column: 1 / 7; grid-row: 2; border-top: var(--rule) solid var(--blue); padding-top: 12px; }
  .hero__photo { grid-column: 9 / 13; grid-row: 1 / 3; min-height: 420px; }

  /* ---------- prossimi eventi ---------- */
  .prossimi { padding-block: clamp(64px, 9vw, 128px); border-top: var(--rule) solid var(--blue); }
  .prossimi__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 32px; margin-bottom: clamp(28px, 3.5vw, 48px); }

  /* ---------- chi siamo ---------- */
  .chi { padding-block: clamp(72px, 10vw, 144px); border-top: var(--rule) solid var(--blue); }
  .chi__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px clamp(16px, 2vw, 32px); align-items: baseline; }
  .chi__label { grid-column: 1 / 4; }
  .chi__text { grid-column: 4 / 13; font-size: var(--step-3); line-height: 0.98; max-width: 18ch; }
  .chi__alt { color: var(--overprint); }

  /* ---------- album ---------- */
  .archivio { padding-block: clamp(72px, 10vw, 144px); border-top: var(--rule) solid var(--blue); }
  .archivio__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 32px; margin-bottom: clamp(32px, 4vw, 56px); }
  .archivio__strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 2.4vw, 40px); }

  /* ---------- tessera ---------- */
  .tessera-sec { background: var(--pink); color: var(--overprint); padding-block: clamp(72px, 10vw, 144px); }
  .tessera-sec ::selection { background: var(--overprint); color: var(--pink); }
  .tessera-sec :focus-visible { outline-color: var(--overprint); }
  .tessera-sec__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 48px clamp(16px, 2vw, 32px); align-items: center; }
  .tessera-sec__copy { grid-column: 1 / 6; grid-row: 1; align-self: end; display: grid; gap: 28px; justify-items: start; }
  .tessera-sec .tessera { grid-column: 7 / 13; grid-row: 1 / 3; }
  .tessera-sec .verifica { grid-column: 1 / 6; grid-row: 2; align-self: start; }
  .tessera {
    position: relative;
    z-index: 2;
    padding: 18px 24px 20px;
    background: var(--paper);
    border: var(--rule) solid var(--blue);
    transform: rotate(-2.5deg);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px 24px;
  }
  .tessera__head { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-bottom: var(--rule) solid var(--blue); padding-bottom: 10px; }
  .tessera__name {
    grid-column: 1 / -1;
    grid-row: 2;
    font-stretch: 125%;
    font-weight: 900;
    font-size: clamp(1.35rem, 1.9vw, 1.8rem);
    line-height: 1;
    align-self: end;
    letter-spacing: -0.03em;
    min-height: 1em;
    overflow-wrap: anywhere;
  }
  .tessera__name.is-empty .reg__blue { opacity: 0.45; }
  .tessera__price {
    grid-column: 2;
    grid-row: 3;
    align-self: stretch;
    display: grid;
    place-items: center;
    padding: 0.08em 0.14em 0.02em;
    background: var(--blue);
    color: var(--paper);
    font-size: clamp(5rem, 7vw, 7.4rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    transform: translate(5px, 4px);
    transition: transform 420ms var(--ease-out);
  }
  .tessera:hover .tessera__price, .tessera:focus-within .tessera__price { transform: none; }
  .tessera__fields { grid-column: 1; grid-row: 3; display: grid; gap: 8px; }
  .tessera__fields .field input { min-height: 42px; font-size: var(--step-0); padding-block: 6px 4px; }
  .tessera__go { grid-column: 1; grid-row: 4; justify-self: start; white-space: nowrap; }

  .verifica { display: flex; align-items: end; gap: 16px; flex-wrap: wrap; }
  .verifica .field { min-width: min(260px, 100%); }
  .verifica .field input { border-bottom-color: var(--overprint); color: var(--overprint); }
  .verifica .btn--paper { color: var(--overprint); --under: var(--overprint); }
  .verifica .btn--paper:hover, .verifica .btn--paper:focus-visible { color: var(--pink); }

  /* ---------- contatti ---------- */
  .contatti { padding-block: clamp(72px, 10vw, 144px); }
  .contatti__in { display: grid; gap: 24px; justify-items: start; }
  .contatti__mail {
    font-stretch: 112%;
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.1;
    overflow-wrap: anywhere;
    text-decoration-thickness: 3px;
  }
  .contatti__mail:hover { color: var(--overprint); }
  .contatti__social { display: flex; flex-wrap: wrap; gap: 12px 28px; }

  /* ---------- responsive ---------- */
  @media (max-width: 1080px) {
    .hero__title { grid-column: 1 / 8; }
    .hero__photo { grid-column: 8 / 13; min-height: 360px; }
    .chi__label, .chi__text { grid-column: 1 / -1; }
    .archivio__strip { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 40%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
    .archivio__strip > li { scroll-snap-align: start; }
    .tessera-sec__copy, .tessera-sec .tessera, .tessera-sec .verifica { grid-column: 1 / -1; grid-row: auto; }
    .tessera-sec .tessera { max-width: 560px; }
  }
  @media (max-width: 760px) {
    .hero { padding-bottom: 104px; }
    .hero__grid { min-height: 0; display: flex; flex-direction: column; }
    .hero__title { margin-top: 12px; }
    .hero__photo { min-height: 0; aspect-ratio: 4 / 3; margin-top: 8px; }
    .tessera { margin-inline: 4px; transform: rotate(-1.5deg); padding: 18px 18px 20px; }
    .tessera__price { font-size: 4.6rem; grid-row: 3; }
    .tessera__head p:last-child { display: none; }
    .tessera__go { width: 100%; grid-column: 1 / -1; }
    .archivio__strip { grid-auto-columns: 72%; }
    .verifica .btn { width: 100%; }
    .contatti__mail { font-size: var(--step-1); overflow-wrap: break-word; }
  }
</style>
